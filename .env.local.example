# Supabase Project Credentials (required)
# Copy to .env.local and fill with values from your Supabase project settings.
# Never commit real keys. Rotate any keys that were previously committed.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Stable production origin — required for Google OAuth.
# Must match Supabase Authentication → Site URL.
# Never use a Vercel deployment-id hostname (foo-123.vercel.app).
# Example: https://qlash.vercel.app  or  https://qlash.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
